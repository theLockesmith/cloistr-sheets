{
  "name": "cloistr-sheets",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Collaborative spreadsheet editor for Cloistr (Google Sheets alternative)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloistr/auth": "^0.6.0",
    "@cloistr/collab-common": "^0.2.14",
    "@cloistr/ui": "^0.40.0",
    "@univerjs/core": "^0.25.1",
    "@univerjs/design": "^0.25.1",
    "@univerjs/docs": "^0.25.1",
    "@univerjs/docs-ui": "^0.25.1",
    "@univerjs/engine-formula": "^0.25.1",
    "@univerjs/engine-render": "^0.25.1",
    "@univerjs/sheets": "^0.25.1",
    "@univerjs/sheets-formula": "^0.25.1",
    "@univerjs/sheets-formula-ui": "^0.25.1",
    "@univerjs/sheets-ui": "^0.25.1",
    "@univerjs/themes": "^0.25.1",
    "@univerjs/ui": "^0.25.1",
    "cloistr-collab-common": "file:../cloistr-collab-common",
    "nostr-tools": "^2.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
